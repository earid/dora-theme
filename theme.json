			"fontStyle": "normal",
			"fontWeight": "400",
			"letterSpacing": "normal",
			"lineHeight": "1.6",
			"textDecoration": "none"
		},

		"elements": {
			"button": {
				"border": {
					"radius": "var(--wp--custom--border--radius--medium)",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|white"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.5rem",
						"bottom": "0.75rem",
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontSize": "1rem",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"textDecoration": "none"
				}
			},

			"button:hover": {
				"color": {
					"background": "var:preset|color|primary-dark",
					"text": "var:preset|color|white"
				}
			},

			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				"typography": {
					"textDecoration": "none"
				}
			},

			"link:hover": {
				"color": {
					"text": "var:preset|color|primary-dark"
				},
				"typography": {
					"textDecoration": "underline"
				}
			},

			"heading": {
				"color": {
					"text": "var:preset|color|foreground"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "-0.02em"
				}
			},

			"h1": {
				"typography": {
					"fontSize": "clamp(2.5rem, 6vw, 4.5rem)",
					"fontWeight": "800",
					"lineHeight": "1.05",
					"letterSpacing": "-0.04em"
				}
			},

			"h2": {
				"typography": {
					"fontSize": "clamp(2rem, 4vw, 3.25rem)",
